---
import Navbar from "./Navbar.astro";

const slides = [
  {
    src: "https://images.pexels.com/photos/33650626/pexels-photo-33650626.jpeg?auto=compress&cs=tinysrgb&w=1920",
    alt: "Scenic African safari landscape",
  },
  {
    src: "https://images.pexels.com/photos/28359728/pexels-photo-28359728.jpeg?auto=compress&cs=tinysrgb&w=1920",
    alt: "Wildlife roaming the African savanna",
  },
  {
    src: "https://images.pexels.com/photos/28812642/pexels-photo-28812642.jpeg?auto=compress&cs=tinysrgb&w=1920",
    alt: "Golden sunset over the African plains",
  },
  {
    src: "https://assets.makisala.com/accommodations/c74019d5-1402-4e78-918f-6b576dec69f0/1771279089075-1750156182047_0G5A9780.webp",
    alt: "Luxury safari lodge accommodation",
  },
];
---

<section
  id="hero"
  class="relative flex h-screen w-full flex-col items-center justify-end overflow-hidden bg-[#1A1A1A] pb-28 md:pb-36"
>
  <div id="hero-slideshow" class="absolute inset-0 size-full">
    {
      slides.map((slide, i) => (
        <img
          src={slide.src}
          alt={slide.alt}
          class="hero-slide absolute inset-0 size-full object-cover transition-opacity duration-1000 ease-in-out"
          style={{ opacity: i === 0 ? 1 : 0 }}
          loading={i === 0 ? "eager" : "lazy"}
        />
      ))
    }
  </div>
  <div class="absolute inset-0 bg-black/40"></div>

  <Navbar />

  <div class="relative z-10 flex max-w-[900px] flex-col items-center gap-5 px-4 text-center">
    <h1 class="font-display text-4xl leading-tight text-white md:text-6xl lg:text-7xl">
      Tanzania, The Way It’s Meant To Be Experienced
    </h1>
    <p class="font-display text-base italic tracking-[0.02em] text-white/90 md:text-lg">
      Private crafted experiences by the locals
    </p>
    <a
      href="/plan-my-trip"
      class="mt-3 border border-white/70 bg-primary px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-white transition-colors hover:bg-white hover:text-primary"
    >
      Plan My Trip
    </a>
  </div>

  <a
    href="#contact"
    aria-label="Chat with us on WhatsApp"
    class="fixed bottom-6 right-6 z-40 flex items-center justify-center rounded-full bg-green-500 p-4 shadow-lg transition-transform hover:scale-105 md:right-8"
  >
    <svg width="24" height="24" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
      <path
        d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        fill="#FFFFFF"
      />
    </svg>
  </a>
</section>

<script>
  const slides = document.querySelectorAll<HTMLImageElement>("#hero-slideshow .hero-slide");
  if (slides.length > 1) {
    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[current].style.opacity = "0";
      slides[next].style.opacity = "1";
      current = next;
    }, 5000);
  }
</script>
