---
import Navbar from "./Navbar.astro";

const heroImage = "/images/hero-couple.jpg";

// Default the arrival date to roughly a month out, and never allow a past date.
const today = new Date();
const minDate = today.toISOString().slice(0, 10);
const defaultDate = new Date(today.getTime() + 30 * 86400000).toISOString().slice(0, 10);

const promises = [
  "Private guide and 4x4",
  "Tanzania specialists only",
  "5-star traveller reviews",
  "Free, no-obligation quote",
];
---

<section
  id="hero"
  class="relative flex w-full flex-col overflow-hidden bg-primary lg:min-h-[90vh]"
>
  <img
    src={heroImage}
    alt="A couple walking hand in hand beside their safari vehicle on the open plains"
    class="h-64 w-full object-cover sm:h-80 lg:absolute lg:inset-0 lg:size-full"
    fetchpriority="high"
  />
  <div class="absolute inset-0 hidden bg-gradient-to-r from-black/70 via-black/40 to-black/60 lg:block"></div>

  <Navbar />

  <div
    class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-1 flex-col gap-6 px-6 pb-0 pt-7 md:px-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:pb-20 lg:pt-8"
  >
    <div class="contents lg:flex lg:max-w-[620px] lg:flex-col lg:gap-5 lg:text-left">
      <h1 class="order-1 text-center font-display text-4xl font-medium text-white sm:text-5xl md:text-6xl lg:order-none lg:text-left">
        A Private Tanzania Safari, Shaped Around You
      </h1>
      <p
        class="hidden max-w-[430px] font-display text-lg leading-relaxed tracking-[0.02em] text-white/90 lg:block lg:text-xl xl:max-w-[500px]"
      >
        Just you and your guide in your own 4x4 — no shared vehicles, no fixed departures.
        Tell us who's coming and roughly when, and guides born in Tanzania plan the rest.
      </p>

      <ul class="order-4 -mx-6 grid grid-cols-1 gap-4 bg-white px-8 py-8 md:-mx-10 md:px-10 lg:order-none lg:mx-0 lg:mt-5 lg:grid-cols-[auto_auto] lg:justify-start lg:gap-x-7 lg:gap-y-4 lg:bg-transparent lg:px-0 lg:py-0">
        {
          promises.map((promise) => (
            <li class="flex items-center gap-3 font-body text-sm font-medium text-text lg:gap-2.5 lg:text-white">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full border border-accent bg-accent text-white lg:size-5 lg:bg-transparent lg:text-accent" aria-hidden="true">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12.5 9.5 18 20 6.5" />
                </svg>
              </span>
              {promise}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Step one of the trip planner: party size and dates, handed to /plan-my-trip -->
    <form
      method="get"
      action="/plan-my-trip"
      class="order-3 w-full shrink-0 p-0 lg:order-none lg:max-w-[440px] lg:border lg:border-white/10 lg:bg-primary/90 lg:p-9 lg:pb-9 lg:backdrop-blur-md"
      data-hero-planner
    >
      <h2 class="sr-only mb-7 font-display text-[28px] font-medium leading-[1.15] text-white sm:text-[32px] lg:not-sr-only">
        Start Planning Your Tanzania Trip
      </h2>

      <div class="grid grid-cols-2 gap-4">
        <label class="flex flex-col gap-2">
          <span class="font-body text-xs font-semibold uppercase tracking-[0.14em] text-white/70">Adults</span>
          <span class="relative block">
            <input
              type="number"
              name="adults"
              value="2"
              min="1"
              max="20"
              inputmode="numeric"
              class="hero-field w-full bg-white px-4 py-3 pr-11 font-body text-base text-primary focus:outline-none focus:ring-2 focus:ring-accent"
            />
            <span
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-primary/35"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M5 21v-1a7 7 0 0 1 14 0v1"></path>
              </svg>
            </span>
          </span>
        </label>

        <label class="flex flex-col gap-2">
          <span class="font-body text-xs font-semibold uppercase tracking-[0.14em] text-white/70">Children</span>
          <span class="relative block">
            <input
              type="number"
              name="children"
              value="0"
              min="0"
              max="20"
              inputmode="numeric"
              class="hero-field w-full bg-white px-4 py-3 pr-11 font-body text-base text-primary focus:outline-none focus:ring-2 focus:ring-accent"
            />
            <span
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-primary/35"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="3.2"></circle>
                <path d="M7 21v-4a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
          </span>
        </label>
      </div>

      <label class="mt-5 flex flex-col gap-2">
        <span class="font-body text-xs font-semibold uppercase tracking-[0.14em] text-white/70">Estimated arrival date</span>
        <span class="relative block">
          <input
            type="date"
            name="arrival"
            value={defaultDate}
            min={minDate}
            class="hero-field w-full bg-white px-4 py-3 pr-11 font-body text-base text-primary focus:outline-none focus:ring-2 focus:ring-accent"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-primary/35"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M8 3v4M16 3v4M3 10h18"></path>
            </svg>
          </span>
        </span>
      </label>

      <button
        type="submit"
        class="mt-6 w-full bg-accent px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-white transition-colors hover:bg-accent-dark"
      >
        Build My Itinerary
      </button>

      <p class="mt-4 text-center font-body text-xs leading-relaxed text-white/60">
        No cost, no commitment. We’ll send back a draft itinerary you can change as much as you like.
      </p>
    </form>
  </div>

  <a
    href="#contact"
    aria-label="Chat with us on WhatsApp"
    class="fixed bottom-6 right-6 z-40 flex items-center justify-center rounded-full bg-green-500 p-4 shadow-lg transition-transform hover:scale-105 md:right-8"
  >
    <svg width="24" height="24" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
      <path
        d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        fill="#FFFFFF"
      />
    </svg>
  </a>
</section>

<style>
  /* Native spinners and the date picker chrome clash with the custom icon blocks. */
  .hero-field::-webkit-outer-spin-button,
  .hero-field::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .hero-field[type="number"] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .hero-field[type="date"] {
    -webkit-appearance: none;
    appearance: none;
  }

  /* Stretch the invisible picker trigger over the calendar icon block. */
  .hero-field[type="date"]::-webkit-calendar-picker-indicator {
    position: absolute;
    inset: 0 0 0 auto;
    width: 3rem;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
  }
</style>
