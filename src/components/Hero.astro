---
const slides = [
  { src: "/images/hero/01-friends.jpg", alt: "Two friends with sundowners beside a fire pit, looking out over the plains at dusk" },
  { src: "/images/hero/02-kido.jpg", alt: "A Maasai guide and a young boy coaxing a bundle of tinder into flame" },
  { src: "/images/hero/03-couples.jpg", alt: "A couple at breakfast on a camp deck as the sun rises over the acacias" },
  { src: "/images/hero/04-family.jpg", alt: "A family walking the grasslands with their Maasai guides, zebra grazing beyond" },
];
---

<section
  id="hero"
  class="relative flex min-h-[78vh] w-full flex-col overflow-hidden bg-primary lg:min-h-[calc(100vh-97px)]"
>
  <div class="absolute inset-0" data-hero-slideshow>
    {
      slides.map((slide, i) => (
        <img
          src={slide.src}
          alt={i === 0 ? slide.alt : ""}
          class:list={["hero-slide absolute inset-0 size-full object-cover", i === 0 && "is-active"]}
          width="2400"
          height="1600"
          decoding="async"
          fetchpriority={i === 0 ? "high" : "low"}
          aria-hidden={i === 0 ? undefined : "true"}
          data-hero-slide
        />
      ))
    }
  </div>

  <!-- Enough of a scrim to hold the centred copy, without dulling the light behind it. -->
  <div class="absolute inset-0 bg-black/30"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/10 to-black/50"></div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-1 flex-col items-center justify-end px-6 pb-16 pt-24 text-center md:px-10 lg:pb-24 lg:pt-32"
  >
    <h1
      class="max-w-[26ch] text-balance font-display text-[2.1rem] font-medium leading-[1.1] text-white drop-shadow-[0_2px_18px_rgba(0,0,0,0.45)] sm:text-4xl md:text-5xl lg:text-[3.75rem]"
    >
      A Private Tanzania Safari, Shaped Around You
    </h1>

    <a
      href="/plan-my-trip"
      class="mt-8 inline-flex items-center justify-center bg-accent px-10 py-4 font-body text-xs font-semibold uppercase tracking-[0.18em] text-white transition-colors hover:bg-accent-dark sm:text-sm md:px-12"
    >
      Start Planning Your Trip
    </a>
  </div>

  <a
    href="#contact"
    aria-label="Chat with us on WhatsApp"
    class="fixed bottom-6 right-6 z-40 flex items-center justify-center rounded-full bg-green-500 p-4 shadow-lg transition-transform hover:scale-105 md:right-8"
  >
    <svg width="24" height="24" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
      <path
        d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        fill="#FFFFFF"
      />
    </svg>
  </a>
</section>

<style>
  .hero-slide {
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  /* Anyone who has asked the OS to cut motion just gets the first frame. */
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: none;
    }
  }
</style>

<script>
  const HOLD_MS = 6000;

  const slideshow = document.querySelector<HTMLElement>("[data-hero-slideshow]");
  const slides = Array.from(
    slideshow?.querySelectorAll<HTMLImageElement>("[data-hero-slide]") ?? [],
  );

  const stillsOnly = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (slides.length > 1 && !stillsOnly) {
    let current = 0;
    let timer = 0;

    const advance = () => {
      slides[current].classList.remove("is-active");
      current = (current + 1) % slides.length;
      slides[current].classList.add("is-active");
    };

    const start = () => {
      stop();
      timer = window.setInterval(advance, HOLD_MS);
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };

    // No point burning cycles on a tab nobody is looking at.
    document.addEventListener("visibilitychange", () => {
      document.hidden ? stop() : start();
    });

    start();
  }
</script>
