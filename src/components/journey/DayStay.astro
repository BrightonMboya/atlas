---
// The two lodges offered for one night — entry level and top level, side by
// side, so the range a region offers reads without leaving the day.
//
// Only the hero photo is an <img>; the rest of each gallery travels as a data
// attribute and is fetched when PhotoLightbox opens it.
import { stayOptions, type Region } from "../../data/accommodation";

interface Props {
  region: Region;
}

const { region } = Astro.props;
const options = stayOptions(region);
---

{
  options.length > 0 && (
    <div class="space-y-8">
      <div class="flex items-center gap-4">
        <span class="text-xs font-medium tracking-[0.2em] text-stone-400 uppercase">
          Where You'll Stay
        </span>
        <div class="h-px flex-1 bg-stone-200" />
        <span class="text-xs tracking-[0.15em] text-stone-400 uppercase">{region.name}</span>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
        {options.map(({ tier, lodge }) => (
          <figure>
            {lodge.images.length > 0 ? (
              <button
                type="button"
                class="group relative block w-full cursor-pointer overflow-hidden rounded-2xl bg-stone-100"
                data-gallery={JSON.stringify(lodge.images)}
                data-name={lodge.name}
                aria-label={`View photos of ${lodge.name}`}
              >
                <img
                  src={lodge.images[0]}
                  alt={`${lodge.name}, ${region.name}`}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                {lodge.images.length > 1 && (
                  <span class="absolute right-3 bottom-3 flex items-center gap-1.5 rounded-full bg-black/55 px-3 py-1.5 text-xs font-medium text-white backdrop-blur-sm">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="16" rx="2" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="m3 16.5 4.5-4 4 3.5 3.5-3 6 5" />
                    </svg>
                    {lodge.images.length}
                  </span>
                )}
              </button>
            ) : (
              // No photography for this property yet.
              <div class="flex aspect-[3/2] w-full items-center justify-center rounded-2xl bg-stone-100 text-stone-300">
                <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="16" rx="2" />
                  <circle cx="8.5" cy="9.5" r="1.5" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="m3 16.5 4.5-4 4 3.5 3.5-3 6 5" />
                </svg>
              </div>
            )}

            <figcaption class="mt-4">
              <span class="inline-block rounded-full border border-stone-200 px-2.5 py-0.5 text-[10px] font-medium tracking-[0.15em] text-stone-500 uppercase">
                {tier.name}
              </span>
              <span class="mt-2 block font-display text-xl leading-snug text-stone-800">
                {lodge.name}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  )
}
