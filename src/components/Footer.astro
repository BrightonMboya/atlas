---
import { journeys, categoryAnchor } from "../data/journeys";
const safariCategories = [...new Set(journeys.filter((j) => j.activity === "safari").map((j) => j.category))];
const treks = journeys.filter((j) => j.activity === "trek");
// The named Roof of Africa package has different inclusions from the route-only document.
const trekGroup = (journey: typeof treks[number]) => journey.slug === "the-roof-of-africa" ? journey.title : journey.region;
const trekRoutes = [...new Set(treks.map(trekGroup))].map((region) => ({
  label: (region.split("·").pop() ?? region).trim().replace(/ Route$/, ""),
  items: treks.filter((j) => trekGroup(j) === region).sort((a, b) => a.days - b.days),
}));
const year = new Date().getFullYear();
---

<footer class="atlas-footer">
  <div class="footer-inner">
    <div class="footer-invitation">
      <div><h2>A journey that feels like yours.</h2><p>Tell us when you’d like to travel and what you’d love to see. We’ll help shape the rest.</p></div>
      <a class="footer-plan" href="/plan-my-trip">Plan my trip<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a>
    </div>
    <div class="footer-directory">
      <div class="footer-brand">
        <a href="/" aria-label="Atlas Tanzania home"><img src="/images/logo-dark.png" alt="Atlas Tanzania" width="900" height="344" loading="lazy" /></a>
        <p>Private safaris and mountain treks.<br />Tanzania, at your own pace.</p>
        <a class="all-journeys" href="/journeys">Explore all journeys</a>
      </div>
      <nav aria-labelledby="footer-safaris"><h3 id="footer-safaris"><a href="/journeys#safaris">Safaris</a></h3><ul>{safariCategories.map((category) => <li><a href={`/journeys#${categoryAnchor(category)}`}>{category}</a></li>)}</ul></nav>
      <nav aria-labelledby="footer-trekking"><h3 id="footer-trekking"><a href="/journeys#trekking">Mountain treks</a></h3><ul class="trek-routes">{trekRoutes.map((route) => <li><span>{route.label}</span><div>{route.items.map((journey) => <a href={`/journeys/${journey.slug}`} aria-label={`${route.label}, ${journey.days} days`}>{journey.days} days</a>)}</div></li>)}</ul></nav>
      <nav aria-labelledby="footer-atlas"><h3 id="footer-atlas">Your trip with Atlas</h3><ul><li><a href="/plan-my-trip">Plan my trip</a></li><li><a href="/plan-my-trip">Contact us</a></li></ul></nav>
    </div>
    <div class="footer-bottom"><p>&copy; {year} Atlas Safaris. All rights reserved.</p><span>Tanzania & Zanzibar</span></div>
  </div>
</footer>

<style>
  .atlas-footer { background: #f7f7f4; border-top: 1px solid var(--color-border); color: var(--color-primary); }
  .footer-inner { max-width: 1280px; margin: auto; padding: 0 40px; }
  .footer-invitation { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 44px 0; border-bottom: 1px solid var(--color-border); }
  .footer-invitation h2 { font: 500 38px/1.1 var(--font-display); }
  .footer-invitation p { margin-top: 12px; max-width: 540px; font-size: 14px; line-height: 1.6; color: var(--color-text-muted); }
  .footer-plan { display: flex; justify-content: space-between; align-items: center; gap: 40px; padding: 17px 24px; background: var(--color-primary); color: white; font-size: 14px; white-space: nowrap; }
  .footer-plan:hover { background: var(--color-accent-dark); color: white; }
  .footer-directory { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1fr; gap: 40px; padding: 48px 0; }
  .footer-brand img { width: 156px; height: auto; }
  .footer-brand p { font-size: 13px; line-height: 1.8; color: var(--color-text-muted); margin: 20px 0; }
  .all-journeys { font-size: 13px; text-decoration: underline; text-underline-offset: 5px; }
  nav h3 { font: 600 23px/1.2 var(--font-display); margin-bottom: 18px; }
  nav li { font-size: 13px; line-height: 1.5; margin-top: 12px; }
  .trek-routes li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .trek-routes li div { display: flex; flex-wrap: wrap; justify-content: end; gap: 6px 12px; }
  .trek-routes li a { white-space: nowrap; color: var(--color-text-muted); text-decoration: underline; text-underline-offset: 4px; font-size: 12px; }
  a:hover { color: var(--color-accent-dark); }
  a:focus-visible { outline: 2px solid var(--color-accent-dark); outline-offset: 5px; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid var(--color-border); padding: 24px 0; font-size: 11px; color: var(--color-text-muted); }
  @media (max-width: 1023px) { .footer-directory { grid-template-columns: 1fr 1fr; gap: 36px 60px; } }
  @media (max-width: 600px) { .footer-inner { padding: 0 24px; } .footer-invitation { align-items: start; flex-direction: column; gap: 24px; padding: 32px 0; } .footer-invitation h2 { font-size: 32px; } .footer-directory { grid-template-columns: 1fr 1fr; gap: 36px 24px; padding: 36px 0; } .footer-brand { grid-column: 1 / -1; } nav h3 { font-size: 22px; } .trek-routes li { display: block; } .trek-routes li div { justify-content: start; margin-top: 5px; } .footer-bottom { flex-direction: column; gap: 8px; } }
</style>
