const year = new Date().getFullYear();
---

<footer class="w-full border-t border-border">
  <div class="max-w-6xl mx-auto px-6 md:px-8 pt-20 pb-10">
    <a href="/" class="mb-12 inline-block" aria-label="Atlas Tanzania home">
      <img
        src="/images/logo-dark.png"
        alt="Atlas Tanzania"
        class="h-14 w-auto md:h-16"
        width="900"
        height="344"
        loading="lazy"
      />
    </a>

    <div class="flex flex-col justify-between gap-12 md:flex-row">
      <div>
        <h3 class="font-display text-primary text-2xl font-medium mb-4">Plan Your Trip</h3>
        <p class="font-body text-text-muted leading-relaxed mb-6 max-w-xs">
          Every Atlas journey is private and built around you. Tell us what you have in mind and
          we will shape an itinerary around it.
        </p>
        <a
          href="/plan-my-trip"
          class="inline-block border border-accent bg-accent px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-white transition-colors hover:bg-transparent hover:text-accent-dark"
        >
          Plan My Trip
        </a>
      </div>

      <div>
        <h3 class="font-display text-primary text-2xl font-medium mb-4">Our Journeys</h3>
        <ul class="grid gap-1">
          {journeyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-body text-text hover:underline hover:underline-offset-2"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-y-4 pt-8 lg:flex-row border-t border-border">
      <ul class="flex flex-col gap-2 text-center text-sm sm:flex-row sm:gap-4">
        <li>
          <p class="text-text-muted">All rights reserved &copy; {year} Atlas Safaris</p>
        </li>
        <li class="text-text-muted hover:underline">
          <a href="/plan-my-trip">Contact</a>
        </li>
      </ul>
      <div class="flex w-fit gap-x-4">
        {socials.map((social) => {
          const Tag = social.href ? "a" : "span";
          return (
            <Tag
              href={social.href || undefined}
              target={social.href ? "_blank" : undefined}
              rel={social.href ? "noopener noreferrer" : undefined}
              aria-label={social.label}
              title={social.label}
            >
              <svg
                viewBox={social.viewBox}
                fill={social.color}
                class:list={["size-6", social.href && "cursor-pointer"]}
                role="img"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d={social.path} />
              </svg>
            </Tag>
          );
        })}
      </div>
    </div>
  </div>
</footer>
