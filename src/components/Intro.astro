---
import { journeys } from "../data/journeys";
import JourneyCard from "./JourneyCard.astro";

// Six hand-picked journeys spanning the catalogue; the rest live on /journeys.
const featured = journeys.filter((journey) => journey.featured);
---

<section
  id="itineraries"
  class="w-full max-w-6xl mx-auto mt-16 md:mt-28 flex flex-col items-center px-4 sm:px-8 scroll-mt-24"
>
  <h2
    class="font-display text-[38px] sm:text-[46px] md:text-[54px] text-center leading-tight md:leading-14.5 text-primary"
  >
    Ways Into Tanzania
  </h2>
  <p class="font-display text-lg italic text-center mt-2 mb-8 md:mb-12 text-text-muted">
    Starting points, not packages — every route below is private and yours to reshape
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
    {featured.map((journey) => <JourneyCard journey={journey} />)}
  </div>

  <a
    href="/journeys"
    class="font-body text-sm font-semibold mt-10 md:mt-14 rounded-full border border-primary/25 text-primary py-3.5 px-9 transition-colors hover:bg-primary hover:text-white"
  >
    All Itineraries
  </a>
</section>
