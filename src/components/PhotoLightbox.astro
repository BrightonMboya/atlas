---
// One dialog for the whole page, so the markup and the listener exist once
// however many triggers are shown. Two kinds of trigger open it:
//
//   [data-gallery]        one property: its own JSON list of photos, from photo 1.
//   [data-gallery-group]  one photo in a set: every trigger sharing the group
//                         name, in page order, opened at this one. Each carries
//                         its full-size file in data-full and caption in data-name.
---

<dialog
  data-lightbox
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-stone-950/90"
  aria-label="Photos"
>
  <div class="flex h-full flex-col items-center justify-center gap-4 px-4 py-6 sm:px-14">
    <img
      data-lightbox-image
      src=""
      alt=""
      class="max-h-[75vh] w-auto max-w-full rounded-lg object-contain"
    />
    <div class="text-center">
      <p data-lightbox-caption class="font-display text-xl text-white"></p>
      <p data-lightbox-count class="mt-1 text-xs tracking-[0.2em] text-white/60 uppercase"></p>
    </div>

    <button
      type="button"
      data-lightbox-close
      class="absolute top-4 right-4 flex size-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
      aria-label="Close photos"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <button
      type="button"
      data-lightbox-prev
      class="absolute top-1/2 left-2 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:left-4"
      aria-label="Previous photo"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>

    <button
      type="button"
      data-lightbox-next
      class="absolute top-1/2 right-2 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:right-4"
      aria-label="Next photo"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>
</dialog>

<script>
  interface Photo {
    src: string;
    caption: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const caption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const counter = dialog?.querySelector<HTMLElement>("[data-lightbox-count]");

  if (dialog && image && caption && counter) {
    let gallery: Photo[] = [];
    let index = 0;

    function show(next: number) {
      if (gallery.length === 0) return;
      index = (next + gallery.length) % gallery.length;
      const photo = gallery[index];
      image!.src = photo.src;
      image!.alt = `${photo.caption}, photo ${index + 1} of ${gallery.length}`;
      caption!.textContent = photo.caption;
      counter!.textContent = `${index + 1} / ${gallery.length}`;
      // Warm the next photo so stepping forward feels instant.
      if (gallery.length > 1) new Image().src = gallery[(index + 1) % gallery.length].src;
    }

    function open(photos: Photo[], start: number) {
      if (photos.length === 0) return;
      gallery = photos;
      show(start);
      dialog!.showModal();
    }

    // Delegated, so triggers revealed later (filters, lazy sections) still work.
    document.addEventListener("click", (event) => {
      const trigger = (event.target as Element | null)?.closest<HTMLElement>(
        "[data-gallery], [data-gallery-group]",
      );
      if (!trigger) return;

      const group = trigger.dataset.galleryGroup;
      if (group) {
        const members = [
          ...document.querySelectorAll<HTMLElement>(`[data-gallery-group="${CSS.escape(group)}"]`),
        ].filter((member) => !member.closest("[hidden]"));
        open(
          members.map((member) => ({ src: member.dataset.full ?? "", caption: member.dataset.name ?? "" })),
          Math.max(0, members.indexOf(trigger)),
        );
        return;
      }

      let sources: string[] = [];
      try {
        sources = JSON.parse(trigger.dataset.gallery ?? "[]");
      } catch {
        sources = [];
      }
      const name = trigger.dataset.name ?? "";
      open(sources.map((src) => ({ src, caption: name })), 0);
    });

    dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(index - 1));
    dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(index + 1));
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());

    // Clicking the backdrop — anywhere that is not a control or the photo.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(index + 1);
      }
    });

    // Swipe on touch screens.
    let touchX: number | null = null;
    dialog.addEventListener("touchstart", (event) => (touchX = event.touches[0].clientX), { passive: true });
    dialog.addEventListener("touchend", (event) => {
      if (touchX === null) return;
      const delta = event.changedTouches[0].clientX - touchX;
      touchX = null;
      if (Math.abs(delta) > 50) show(delta < 0 ? index + 1 : index - 1);
    });

    // Release the photo when the dialog closes so it is not held in memory.
    dialog.addEventListener("close", () => {
      image!.removeAttribute("src");
      gallery = [];
    });
  }
</script>
