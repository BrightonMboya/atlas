---
// One bar for the whole site: a white header that sits above the page, so a
// full-bleed hero starts cleanly beneath it.
const links = [
  { label: "Safaris", href: "/journeys" },
  { label: "Trekking", href: "/journeys#trekking" },
];
---

<nav class="relative z-50 w-full border-b border-border/60 bg-white py-5">
  <div class="mx-auto flex w-full max-w-[1400px] items-center justify-between px-6 md:px-10">
    <a href="/" class="flex shrink-0 items-center" aria-label="Atlas Tanzania home">
      <img
        src="/images/logo-dark.png"
        alt="Atlas Tanzania"
        class="h-12 w-auto md:h-14"
        data-site-logo
        width="900"
        height="344"
      />
    </a>

    <div class="flex items-center gap-8 md:gap-12">
      <div class="hidden items-center gap-8 md:flex lg:gap-12">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="font-body text-xs font-medium tracking-[0.18em] text-primary uppercase transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <a
        href="/plan-my-trip"
        class="bg-accent px-6 py-3.5 font-body text-xs font-semibold tracking-[0.18em] text-white uppercase transition-colors hover:bg-accent-dark md:px-9"
      >
        Plan My Trip
      </a>
    </div>
  </div>
</nav>
