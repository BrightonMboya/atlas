---
interface Props {
  /**
   * "overlay" floats a transparent bar over a full-bleed hero (the trip planner
   * and journey pages). "solid" is a white bar that sits above the page, so the
   * hero image starts cleanly beneath it.
   */
  variant?: "overlay" | "solid";
}

const { variant = "overlay" } = Astro.props;
const isSolid = variant === "solid";

const links = [
  { label: "Safaris", href: "/#itineraries" },
  { label: "Partners", href: "/#partners" },
];
---

<nav
  class:list={[
    "w-full",
    isSolid ? "relative z-50 border-b border-border/60 bg-white py-5" : "fixed inset-x-0 top-0 z-50 py-4",
  ]}
>
  <div class="mx-auto flex w-full max-w-[1400px] items-center justify-between px-6 md:px-10">
    <a href="/" class="flex shrink-0 items-center" aria-label="Atlas Tanzania home">
      <img
        src={isSolid ? "/images/logo-dark.png" : "/images/logo-light.png"}
        alt="Atlas Tanzania"
        class:list={[
          "w-auto",
          isSolid ? "h-12 md:h-14" : "h-11 drop-shadow-[0_2px_6px_rgba(0,0,0,0.45)] md:h-14",
        ]}
        data-site-logo
        width="900"
        height="344"
      />
    </a>

    {
      isSolid ? (
        <div class="flex items-center gap-8 md:gap-12">
          <div class="hidden items-center gap-8 md:flex lg:gap-12">
            {links.map((link) => (
              <a
                href={link.href}
                class="font-body text-xs font-medium uppercase tracking-[0.18em] text-primary transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            ))}
          </div>
          <a
            href="/plan-my-trip"
            class="bg-accent px-6 py-3.5 font-body text-xs font-semibold uppercase tracking-[0.18em] text-white transition-colors hover:bg-accent-dark md:px-9"
          >
            Plan My Trip
          </a>
        </div>
      ) : (
        <div class="flex items-center gap-2 rounded-full border border-primary/50 bg-white/90 p-1.5 backdrop-blur-sm md:gap-3 md:p-2">
          <a
            href="/plan-my-trip"
            class="rounded-full bg-accent px-4 py-2.5 font-body text-[14px] leading-[18px] text-white transition-colors hover:bg-accent-dark"
          >
            Plan My Trip
          </a>
          <a
            href="/plan-my-trip"
            class="hidden px-2 font-body text-[14px] leading-[18px] text-primary transition-colors hover:text-dark md:flex md:items-center"
          >
            Contact Us
          </a>
          <span
            aria-hidden="true"
            class="hidden size-10 shrink-0 items-center justify-center rounded-full border border-primary md:flex"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="shrink-0 text-accent">
              <path d="M4 12h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4 18h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4 6h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      )
    }
  </div>
</nav>
