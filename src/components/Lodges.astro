---
interface Lodge {
  name: string;
  image: string;
  href: string;
}

const lodges: Lodge[] = [
  {
    name: "Zuri Zanzibar Hotel & Resort",
    image: "/images/lodge-zuri-zanzibar.webp",
    href: "/lodges/zuri-zanzibar-hotel-and-resort",
  },
  {
    name: "Siringit Camp",
    image: "/images/lodge-siringit-camp.jpg",
    href: "/lodges/siringit-camps",
  },
  {
    name: "Upendo Beach Zanzibar",
    image: "/images/lodge-upendo-beach-zanzibar.jpg",
    href: "/lodges/upendo-beach-zanzibar",
  },
];
---

<section id="lodges" class="w-full bg-dark">
  <div class="w-full max-w-5xl mx-auto px-6 md:px-8 py-20 md:py-24 flex flex-col items-center">
    <h2 class="font-display text-[32px] md:text-[48px] text-center mb-3 leading-tight md:leading-14.5 text-lightest">
      Not Sure Where to Stay?
    </h2>
    <p class="font-body text-[16px] text-center leading-[162.5%] mb-10 max-w-2xl text-lighter">
      Whether you're looking for a budget-friendly option or a luxurious retreat, we have a range of
      accommodations that we work with to suit your needs.
    </p>

    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
      {lodges.map((lodge) => (
        <a href={lodge.href} class="group w-full">
          <div class="w-full h-64 md:h-80 rounded-xl overflow-hidden relative">
            <img
              src={lodge.image}
              alt={lodge.name}
              class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-110"
            />
          </div>
          <p class="font-body text-[18px] mt-4 text-center text-lightest">
            {lodge.name}
          </p>
        </a>
      ))}
    </div>

    <a
      href="/lodges"
      class="font-body py-2.5 px-8 rounded-full border border-solid border-lightest text-[18px] leading-5.5 text-lightest transition-colors hover:bg-lightest hover:text-darker"
    >
      Find More
    </a>
  </div>
</section>
