---
interface Partner {
  name: string;
  logo: string;
  href: string;
}

const partners: Partner[] = [
  {
    name: "Kafika House",
    logo: "/images/partner-kafika-house.png",
    href: "/partners/kafika-house",
  },
  {
    name: "Rustic Pathways",
    logo: "/images/partner-rustic-pathways.png",
    href: "/partners/rustic-pathways",
  },
  {
    name: "TATO",
    logo: "/images/partner-tato.png",
    href: "https://www.tatotz.org/",
  },
];
---

<section id="partners" class="w-full py-20 md:py-28">
  <div class="w-full max-w-256 mx-auto px-6 md:px-8 flex flex-col items-center">
    <h2 class="font-display text-[32px] md:text-[48px] text-center mb-3 leading-tight md:leading-14.5 text-primary">
      Our Partners
    </h2>
    <p class="font-body text-[16px] text-center leading-[162.5%] mb-10 max-w-3xl text-text">
      We work with camps, lodges and Tanzanian organisations we know first-hand — so the places
      we put you are places we have stayed in ourselves.
    </p>

    <div class="w-full flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
      {partners.map((partner) => (
        <a
          href={partner.href}
          target={partner.href.startsWith("http") ? "_blank" : undefined}
          rel={partner.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="flex items-center justify-center h-16 md:h-20 grayscale opacity-80 transition-all duration-300 hover:grayscale-0 hover:opacity-100"
        >
          <img
            src={partner.logo}
            alt={`${partner.name} logo`}
            class="h-full w-auto object-contain"
          />
        </a>
      ))}
    </div>
  </div>
</section>
