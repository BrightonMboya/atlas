---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Option {
  value: string;
  label: string;
}

interface Step {
  id: string;
  kind: "single" | "multi" | "date";
  title: string;
  hint: string;
  skip?: string;
  /** Omitted on "date" steps, which render a picker instead of chips. */
  options?: Option[];
}

const steps: Step[] = [
  {
    id: "see",
    kind: "multi",
    title: "What would you like to see?",
    hint: "Select one or more",
    options: [
      { value: "plains", label: "The Serengeti's endless plains" },
      { value: "crater", label: "The Ngorongoro Crater" },
      { value: "elephants", label: "Tarangire's elephant herds" },
      { value: "beach", label: "Zanzibar's beaches" },
      { value: "kilimanjaro", label: "Kilimanjaro's summit" },
      { value: "culture", label: "Maasai culture" },
    ],
  },
  {
    id: "interests",
    kind: "multi",
    title: "What draws you?",
    hint: "Select one or more",
    options: [
      { value: "migration", label: "The great migration" },
      { value: "bigcats", label: "Big cats & predators" },
      { value: "walking", label: "Walking safaris" },
      { value: "culture", label: "Culture & community" },
      { value: "romance", label: "Romance & seclusion" },
      { value: "summit", label: "Reaching the summit" },
      { value: "reef", label: "Beach & ocean" },
    ],
  },
  {
    id: "occasion",
    kind: "single",
    title: "Who's travelling?",
    hint: "Select one",
    options: [
      { value: "couple", label: "Just the two of us" },
      { value: "honeymoon", label: "A honeymoon" },
      { value: "family", label: "With family" },
      { value: "friends", label: "With friends" },
      { value: "solo", label: "On my own" },
    ],
  },
  {
    id: "arrival",
    kind: "date",
    title: "When would you like to travel?",
    hint: "An approximate date is fine — we can move it later",
    skip: "I haven't decided yet",
  },
];

const totalSteps = steps.length;

// Never offer a date in the past.
const minDate = new Date().toISOString().slice(0, 10);
---

<Layout
  title="Plan My Trip | Atlas Safaris"
  description="Tell us what you'd love from your next journey and Atlas Safaris will draw the routes that fit."
>
  <Navbar />
  <main class="w-full bg-white text-text" data-planner>
    <!-- Intro -->
    <section class="relative flex min-h-screen flex-col items-center overflow-hidden px-6 text-center" data-screen="intro">
      <img
        src="/images/trip-planner.jpg"
        alt="Two elephants crossing the open grassland on the horizon under a wide pale sky"
        class="absolute inset-0 size-full object-cover"
        width="1672"
        height="941"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/50 to-black/5"></div>
      <div class="relative z-10 flex max-w-xl flex-col items-center gap-5 pt-[18vh] pb-[52vh]">
        <h1 class="font-display text-4xl md:text-6xl leading-tight text-white">
          Shape your Tanzania in minutes
        </h1>
        <p class="font-body text-base md:text-lg text-white/80 leading-relaxed">
          Answer {totalSteps} questions about who's coming and what you'd love to see — then
          private routes that fit, not a checkout.
        </p>
        <button
          type="button"
          class="mt-1 border border-white bg-white px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-primary transition-colors hover:bg-transparent hover:text-white"
          data-go-next
        >
          Let's Begin
        </button>
      </div>
    </section>

    <!-- Steps -->
    {
      steps.map((step, i) => (
        <section
          class="hidden min-h-screen flex-col items-center justify-center px-6 py-24 text-center"
          data-screen="step"
          data-step-id={step.id}
          data-step-kind={step.kind}
        >
          <div class="mb-3 flex items-baseline justify-center gap-4 md:gap-5">
            <span class="font-body text-xs tracking-[0.22em] text-text-muted whitespace-nowrap">
              <span class="text-accent">{i + 1}</span> / {totalSteps}
            </span>
            <h2 class="font-display text-3xl md:text-5xl leading-tight text-primary">{step.title}</h2>
          </div>
          <p class="font-body text-xs uppercase tracking-[0.14em] text-text-muted mb-10">{step.hint}</p>

          {step.kind === "date" ? (
            <div class="flex w-full max-w-sm flex-col items-center gap-5">
              <label class="relative block w-full">
                <span class="sr-only">Arrival date</span>
                <input
                  type="date"
                  min={minDate}
                  class="planner-date w-full border border-border bg-white px-5 py-4 pr-14 text-center font-body text-lg text-text transition-colors hover:border-accent/60 focus:border-accent focus:outline-none"
                  data-date-field
                />
                <span aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-accent">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M8 3v4M16 3v4M3 10h18" />
                  </svg>
                </span>
              </label>
              <p class="min-h-8 font-display text-xl italic text-accent-dark" data-date-pretty />
            </div>
          ) : (
            <div class="flex flex-wrap justify-center gap-3 max-w-3xl">
              {step.options?.map((opt) => (
                <button
                  type="button"
                  class="inline-flex items-center gap-3 border border-border px-5 py-3.5 font-body text-sm text-text transition-colors hover:border-accent data-[selected]:border-accent data-[selected]:bg-accent data-[selected]:text-white"
                  data-option
                  data-step={step.id}
                  data-value={opt.value}
                  aria-pressed="false"
                >
                  {opt.label}
                </button>
              ))}
            </div>
          )}

          {step.skip && (
            <button type="button" class="mt-8 font-body text-sm text-text-muted underline underline-offset-4 hover:text-accent-dark" data-go-next data-skip>
              {step.skip}
            </button>
          )}

          <div class="flex items-center gap-6 mt-12">
            <button type="button" class="font-body text-xs uppercase tracking-[0.12em] text-text-muted hover:text-text" data-go-back>
              Previous
            </button>
            <button
              type="button"
              class="border border-accent bg-accent px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-white transition-colors hover:bg-transparent hover:text-accent-dark disabled:opacity-30 disabled:cursor-not-allowed"
              data-go-next
              disabled
            >
              {i === totalSteps - 1 ? "Continue" : "Next Step"}
            </button>
          </div>
        </section>
      ))
    }

    <!-- Contact -->
    <section class="hidden min-h-screen flex-col justify-center px-6 py-24" data-screen="contact">
      <div class="max-w-xl mx-auto w-full">
        <h2 class="font-display text-2xl md:text-4xl text-primary mb-3">Where should we send your ideas?</h2>
        <p class="font-body text-sm text-text-muted mb-10">
          Leave your details and a guide — not a call centre — will come back with routes that fit.
        </p>

        <p class="font-body text-sm text-text-muted border border-border px-4 py-3 mb-8 hidden" data-party-summary></p>

        <form class="flex flex-col gap-6" data-form novalidate>
          <input type="hidden" name="adults" data-party-field="adults" />
          <input type="hidden" name="children" data-party-field="children" />
          <input type="hidden" name="arrival" data-party-field="arrival" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <label class="flex flex-col gap-2">
              <span class="font-body text-xs uppercase tracking-[0.14em] text-text-muted">Your name</span>
              <input type="text" name="name" autocomplete="name" required class="bg-white border border-border px-4 py-3 font-body text-text focus:outline-none focus:border-accent" />
            </label>
            <label class="flex flex-col gap-2">
              <span class="font-body text-xs uppercase tracking-[0.14em] text-text-muted">Email</span>
              <input type="email" name="email" autocomplete="email" required class="bg-white border border-border px-4 py-3 font-body text-text focus:outline-none focus:border-accent" />
            </label>
          </div>
          <label class="flex flex-col gap-2">
            <span class="font-body text-xs uppercase tracking-[0.14em] text-text-muted">Phone / WhatsApp (optional)</span>
            <input type="tel" name="phone" autocomplete="tel" class="bg-white border border-border px-4 py-3 font-body text-text focus:outline-none focus:border-accent" />
          </label>
          <label class="flex flex-col gap-2">
            <span class="font-body text-xs uppercase tracking-[0.14em] text-text-muted">Anything else we should know? (optional)</span>
            <textarea name="note" rows="3" class="bg-white border border-border px-4 py-3 font-body text-text focus:outline-none focus:border-accent resize-y"></textarea>
          </label>

          <p class="font-body text-sm text-red-700 hidden" data-form-error></p>

          <div class="flex items-center justify-between gap-6 mt-2">
            <button type="button" class="font-body text-xs uppercase tracking-[0.12em] text-text-muted hover:text-text" data-go-back>
              Previous
            </button>
            <button type="submit" class="border border-accent bg-accent px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-white transition-colors hover:bg-transparent hover:text-accent-dark">
              Send My Enquiry
            </button>
          </div>
          <p class="font-body text-xs text-text-muted text-right">We reply within a day, and never share your details.</p>
        </form>
      </div>
    </section>

    <!-- Thank you -->
    <section class="hidden min-h-screen flex-col items-center justify-center px-6 py-24 text-center" data-screen="thanks">
      <span class="font-body text-xs uppercase tracking-[0.2em] text-text-muted mb-4">Enquiry received</span>
      <h2 class="font-display text-3xl md:text-5xl text-primary mb-4 max-w-lg" data-thanks-title>
        Thank you — it's on its way to us.
      </h2>
      <p class="font-body text-text-muted max-w-md leading-relaxed mb-8">
        A guide will read what you've shared and reply personally, usually within a day.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="border border-accent bg-accent px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-white transition-colors hover:bg-transparent hover:text-accent-dark">
          Back To Home
        </a>
        <button type="button" class="border border-border px-8 py-4 font-body text-sm font-semibold uppercase tracking-[0.15em] text-text transition-colors hover:border-accent hover:text-accent-dark" data-restart>
          Plan Another Trip
        </button>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const plannerRoot = document.querySelector<HTMLElement>("[data-planner]");
  if (plannerRoot) {
    // Re-bound so the narrowing survives into the nested handlers below.
    const root: HTMLElement = plannerRoot;
    const screens = Array.from(root.querySelectorAll<HTMLElement>("[data-screen]"));
    const stepScreens = screens.filter((s) => s.dataset.screen === "step");
    const form = root.querySelector<HTMLFormElement>("[data-form]");
    const formError = root.querySelector<HTMLElement>("[data-form-error]");
    const thanksTitle = root.querySelector<HTMLElement>("[data-thanks-title]");
    // The intro sits on a photograph; every screen after it is on white, where
    // the light logo would disappear.
    const siteLogo = document.querySelector<HTMLImageElement>("[data-site-logo]");
    const total = stepScreens.length;

    const answers: Record<string, string[]> = { see: [], interests: [], occasion: [], arrival: [] };

    // The hero form on the home page hands off adults / children / arrival date.
    const params = new URLSearchParams(window.location.search);
    const party = {
      adults: params.get("adults") ?? "",
      children: params.get("children") ?? "",
      arrival: params.get("arrival") ?? "",
    };
    const hasParty = party.adults !== "" || party.arrival !== "";

    root.querySelectorAll<HTMLInputElement>("[data-party-field]").forEach((input) => {
      input.value = party[input.dataset.partyField as keyof typeof party] ?? "";
    });

    const summary = root.querySelector<HTMLElement>("[data-party-summary]");

    /** "12 June 2026", or "" if the value isn't a real date. */
    function longDate(iso: string, withWeekday = false) {
      if (!iso) return "";
      const when = new Date(`${iso}T00:00:00`);
      if (Number.isNaN(when.getTime())) return "";
      return when.toLocaleDateString("en-GB", {
        ...(withWeekday ? { weekday: "long" } : {}),
        day: "numeric",
        month: "long",
        year: "numeric",
      });
    }

    if (party.arrival) answers.arrival = [party.arrival];

    /** The arrival date as it currently stands, or "" if none has been given. */
    function currentArrival() {
      return answers.arrival[0] ?? "";
    }

    function renderSummary() {
      if (!summary) return;
      const adults = Number(party.adults) || 0;
      const children = Number(party.children) || 0;
      const parts: string[] = [];
      if (adults) parts.push(`${adults} adult${adults === 1 ? "" : "s"}`);
      if (children) parts.push(`${children} child${children === 1 ? "" : "ren"}`);
      const arriving = longDate(currentArrival());
      if (arriving) parts.push(`arriving around ${arriving}`);
      if (parts.length) {
        summary.textContent = `You told us: ${parts.join(" · ")}.`;
        summary.classList.remove("hidden");
      } else {
        summary.classList.add("hidden");
      }
    }

    const CONTACT = total + 1;
    const THANKS = total + 2;
    let index = 0;

    function show(i: number) {
      index = i;
      const isIntro = i === 0;
      const isContact = i === CONTACT;
      const isThanks = i === THANKS;
      const stepPos = i - 1;

      screens.forEach((s) => {
        s.classList.add("hidden");
        s.classList.remove("flex");
      });

      let target: HTMLElement | null = null;
      if (isIntro) target = root.querySelector('[data-screen="intro"]');
      else if (isContact) target = root.querySelector('[data-screen="contact"]');
      else if (isThanks) target = root.querySelector('[data-screen="thanks"]');
      else {
        target = stepScreens[stepPos];
        syncNext(target);
      }
      target?.classList.remove("hidden");
      target?.classList.add("flex");

      if (siteLogo) {
        siteLogo.src = isIntro ? "/images/logo-light.png" : "/images/logo-dark.png";
        siteLogo.style.filter = isIntro ? "" : "none";
      }

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    root.querySelectorAll<HTMLButtonElement>("[data-option]").forEach((chip) => {
      chip.addEventListener("click", () => {
        const stepId = chip.dataset.step!;
        const value = chip.dataset.value!;
        const screen = chip.closest<HTMLElement>('[data-screen="step"]')!;
        const kind = screen.dataset.stepKind;

        if (kind === "single") {
          answers[stepId] = [value];
          screen.querySelectorAll<HTMLButtonElement>("[data-option]").forEach((c) => {
            const on = c === chip;
            c.setAttribute("aria-pressed", on ? "true" : "false");
            c.toggleAttribute("data-selected", on);
          });
          setTimeout(() => go(1), 180);
          return;
        }

        const set = new Set(answers[stepId]);
        if (set.has(value)) set.delete(value);
        else set.add(value);
        answers[stepId] = Array.from(set);
        const on = set.has(value);
        chip.setAttribute("aria-pressed", on ? "true" : "false");
        chip.toggleAttribute("data-selected", on);
        syncNext(screen);
      });
    });

    const dateField = root.querySelector<HTMLInputElement>("[data-date-field]");
    const datePretty = root.querySelector<HTMLElement>("[data-date-pretty]");

    function syncArrival() {
      const iso = currentArrival();
      if (dateField) dateField.value = iso;
      if (datePretty) datePretty.textContent = longDate(iso, true);
      root
        .querySelectorAll<HTMLInputElement>('[data-party-field="arrival"]')
        .forEach((input) => (input.value = iso));
      renderSummary();
    }

    dateField?.addEventListener("change", () => {
      answers.arrival = dateField.value ? [dateField.value] : [];
      syncArrival();
    });

    syncArrival();

    function syncNext(screen: HTMLElement | null) {
      if (!screen) return;
      const next = screen.querySelector<HTMLButtonElement>("[data-go-next]:not([data-skip])");
      if (!next) return;
      const stepId = screen.dataset.stepId!;
      const hasAny = (answers[stepId] ?? []).length > 0;
      next.disabled = stepId === "arrival" ? false : !hasAny;
    }

    function go(dir: number) {
      const target = index + dir;
      if (target < 0 || target > THANKS) return;
      show(target);
    }

    root.querySelectorAll<HTMLButtonElement>("[data-go-next]").forEach((b) =>
      b.addEventListener("click", () => {
        if (b.dataset.skip !== undefined) {
          answers.arrival = [];
          syncArrival();
        }
        go(1);
      }),
    );
    root.querySelectorAll<HTMLButtonElement>("[data-go-back]").forEach((b) => b.addEventListener("click", () => go(-1)));
    root.querySelectorAll<HTMLButtonElement>("[data-restart]").forEach((b) =>
      b.addEventListener("click", () => {
        answers.see = [];
        answers.interests = [];
        answers.occasion = [];
        answers.arrival = party.arrival ? [party.arrival] : [];
        root.querySelectorAll<HTMLButtonElement>("[data-option]").forEach((c) => {
          c.removeAttribute("data-selected");
          c.setAttribute("aria-pressed", "false");
        });
        form?.reset();
        root.querySelectorAll<HTMLInputElement>("[data-party-field]").forEach((input) => {
          input.value = party[input.dataset.partyField as keyof typeof party] ?? "";
        });
        syncArrival();
        stepScreens.forEach((s) => syncNext(s));
        show(0);
      }),
    );

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = (data.get("name") ?? "").toString().trim();
        const email = (data.get("email") ?? "").toString().trim();

        if (formError) formError.classList.add("hidden");
        if (!name || !email) {
          if (formError) {
            formError.textContent = "Please add your name and email so we can reply.";
            formError.classList.remove("hidden");
          }
          return;
        }

        if (thanksTitle) thanksTitle.textContent = `Thank you, ${name.split(" ")[0]} — it's on its way to us.`;
        show(THANKS);
      });
    }

    show(hasParty ? 1 : 0);
  }
</script>

<style>
  /* Dark picker chrome, and a blank field reads as a prompt rather than "mm/dd/yyyy" noise. */
  .planner-date {
    color-scheme: light;
  }

  .planner-date::-webkit-datetime-edit {
    color: var(--color-text);
  }

  .planner-date:not(:focus):invalid::-webkit-datetime-edit,
  .planner-date[value=""]:not(:focus)::-webkit-datetime-edit {
    color: var(--color-text-muted);
  }

  /* Stretch the invisible picker trigger over the calendar icon block. */
  .planner-date::-webkit-calendar-picker-indicator {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
  }
</style>
