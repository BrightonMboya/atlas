---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { journeys, journeyGuides, categoryAnchor } from "../../data/journeys";

function group(activity: "safari" | "trek") {
  const items = journeys.filter((journey) => journey.activity === activity);
  return [...new Set(items.map((journey) => journey.category))].map((category) => ({
    category,
    anchor: categoryAnchor(category),
    items: items.filter((journey) => journey.category === category).sort((a, b) => a.days - b.days),
  }));
}

const bands = [
  {
    id: "safaris",
    title: "Safaris",
    blurb: "Find your pace, from a few days in the bush to a safari with time on the coast.",
    groups: group("safari"),
  },
  {
    id: "trekking",
    title: "Trekking",
    blurb: "Compare Kilimanjaro routes and durations, or explore the quieter trails of Mount Meru.",
    groups: group("trek"),
  },
];

const descriptions: Record<string, string> = {
  "Family Safaris": "Wildlife and discovery, with room for everyone’s pace.",
  "Classic Safaris": "Explore Tanzania’s Northern Circuit.",
  "Great Migration": "Journeys built around the movement of the herds.",
  "Honeymoon": "Time together in Tanzania’s wild places.",
  "Safari & Zanzibar": "Pair the bush with the Indian Ocean.",
  "Kilimanjaro Trek": "Lemosho, Machame and Marangu routes to Africa’s highest peak.",
  "Mountain Trek": "A Mount Meru climb through forest and volcanic landscapes.",
};
---

<Layout
  title="Journeys in Tanzania | Atlas Safaris"
  description="Compare private Tanzania safaris and mountain treks by travel style, duration, destinations and price. Every Atlas itinerary can be tailored to you."
>
  <Navbar />
  <div
    id="journeys-top"
    class="min-h-screen scroll-mt-24 bg-[#FDFCFB] font-body text-stone-800 selection:bg-stone-200"
  >
    <!-- Intro -->
    <header class="border-b border-stone-100 bg-white">
      <div
        class="mx-auto grid max-w-screen-xl grid-cols-1 items-center gap-12 px-6 py-16 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16"
      >
        <div>
          <h1 class="mb-6 font-display text-5xl leading-tight text-stone-800 md:text-6xl">
            Welcome to Atlas Tanzania Adventures
          </h1>
          <p class="max-w-xl text-lg leading-relaxed text-stone-600">
            Tanzania is more than a destination, it is a plcae of extraordinary landscapes, unforgettable wildlife,
            vibrant cultures and moments that stay with you long after you leave.
          </p>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-stone-500">
            Explore {journeys.length} private itineraries. Each is a starting point, shaped around you.
          </p>
          <div class="mt-10 flex flex-wrap gap-8">
            {
              bands.map((band) => (
                <a
                  href={`#${band.id}`}
                  class="text-xs tracking-[0.2em] text-stone-500 uppercase underline underline-offset-8 transition-colors hover:text-stone-800"
                >
                  Explore {band.title.toLowerCase()}
                </a>
              ))
            }
          </div>
        </div>
        <img
          src="/images/hero/01-friends.jpg"
          alt="Two friends with sundowners beside a fire pit, looking out over the plains at dusk"
          width="900"
          height="600"
          fetchpriority="high"
          class="h-[340px] w-full rounded-2xl object-cover"
        />
      </div>
    </header>

    <div
      class="mx-auto grid max-w-screen-xl grid-cols-1 gap-16 px-6 py-20 md:py-24 lg:grid-cols-[240px_minmax(0,1fr)]"
    >
      <!-- Browse rail -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <nav aria-label="Browse journeys">
          <h2 class="mb-8 text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
            Browse by experience
          </h2>
          <div class="grid grid-cols-2 gap-8 lg:grid-cols-1">
            {
              bands.map((band) => (
                <div>
                  <a
                    href={`#${band.id}`}
                    class="flex items-baseline justify-between gap-3 border-b border-stone-200 pb-2 font-display text-2xl text-stone-800 transition-colors hover:text-stone-500"
                  >
                    {band.title}
                    <span class="text-[10px] tracking-widest text-stone-400">
                      {band.groups.reduce((n, g) => n + g.items.length, 0)}
                    </span>
                  </a>
                  <ul class="mt-3 space-y-1">
                    {band.groups.map(({ category, anchor, items }) => (
                      <li>
                        <a
                          href={`#${anchor}`}
                          class="flex items-baseline justify-between gap-3 py-1.5 text-sm text-stone-600 transition-colors hover:text-stone-900"
                        >
                          {category}
                          <span class="text-[10px] tracking-widest text-stone-400">
                            {items.length}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </nav>

        <div class="mt-10 hidden border-t border-stone-100 pt-6 lg:block">
          <p class="text-xs leading-relaxed text-stone-500">Not sure where to start?</p>
          <a
            href="/plan-my-trip"
            class="mt-2 inline-block text-xs tracking-[0.15em] text-stone-600 uppercase underline underline-offset-4 transition-colors hover:text-stone-900"
          >
            Let’s plan it together
          </a>
        </div>
      </aside>

      <!-- Results -->
      <div>
        {
          bands.map((band, bandIndex) => (
            <section
              id={band.id}
              class:list={["scroll-mt-24", bandIndex > 0 && "mt-24"]}
              aria-labelledby={`${band.id}-title`}
            >
              <header class="border-b border-stone-800 pb-6">
                <h2 id={`${band.id}-title`} class="font-display text-4xl text-stone-800 md:text-5xl">
                  {band.title}
                </h2>
                <p class="mt-3 max-w-xl leading-relaxed text-stone-500">{band.blurb}</p>
              </header>

              {band.groups.map(({ category, anchor, items }) => (
                <section id={anchor} class="mt-16 scroll-mt-24" aria-labelledby={`${anchor}-title`}>
                  <header class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
                    <div>
                      <h3 id={`${anchor}-title`} class="font-display text-3xl text-stone-800">
                        {category}
                      </h3>
                      {descriptions[category] && (
                        <p class="mt-2 text-sm text-stone-500">{descriptions[category]}</p>
                      )}
                    </div>
                    <span class="text-[10px] tracking-[0.2em] whitespace-nowrap text-stone-400 uppercase">
                      {items.length} {items.length === 1 ? "itinerary" : "itineraries"}
                    </span>
                  </header>

                  <div>
                    {items.map((journey) => (
                      <article class="group flex flex-col gap-6 border-b border-stone-100 py-8 first:pt-0 sm:flex-row sm:gap-8">
                        <a
                          href={`/journeys/${journey.slug}`}
                          class="shrink-0 overflow-hidden rounded-2xl sm:w-56"
                          tabindex="-1"
                          aria-hidden="true"
                        >
                          <img
                            src={journey.image}
                            alt=""
                            loading="lazy"
                            width="480"
                            height="400"
                            class="h-48 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 sm:h-full"
                          />
                        </a>

                        <div class="flex flex-1 flex-col">
                          <span class="text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                            {journey.days} Days
                          </span>
                          <h4 class="mt-2 font-display text-2xl leading-tight text-stone-800 md:text-3xl">
                            <a href={`/journeys/${journey.slug}`}>{journey.title}</a>
                          </h4>
                          <p class="mt-2 text-sm text-stone-500 italic">{journey.region}</p>

                          <div class="mt-6 flex flex-wrap items-end justify-between gap-4 sm:mt-auto">
                            <div class="max-w-sm">
                              {journey.priceSummary.length > 0 ? (
                                journey.priceSummary.map((line) => (
                                  <p class="text-sm leading-relaxed text-stone-600">{line}</p>
                                ))
                              ) : (
                                <a
                                  href="/plan-my-trip"
                                  class="text-sm text-stone-600 underline underline-offset-4 transition-colors hover:text-stone-900"
                                >
                                  Enquire about pricing
                                </a>
                              )}
                            </div>
                            <a
                              class="text-xs tracking-widest whitespace-nowrap text-stone-500 uppercase transition-colors group-hover:text-stone-800"
                              href={`/journeys/${journey.slug}`}
                              aria-label={`View itinerary: ${journey.title}`}
                            >
                              View Itinerary →
                            </a>
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </section>
          ))
        }

        <section class="mt-24 border-t border-stone-100 pt-10" aria-labelledby="journey-guides-title">
          <h2 id="journey-guides-title" class="mb-6 text-sm tracking-[0.2em] text-stone-400 uppercase">
            Explore More
          </h2>
          <div class="space-y-1">
            {
              journeyGuides.map((guide) => (
                <a
                  href={`/journeys/${guide.slug}`}
                  class="block border-b border-stone-100 py-4 font-display text-2xl text-stone-800 transition-colors hover:text-stone-500"
                >
                  {guide.title}
                </a>
              ))
            }
          </div>
        </section>

        <a
          href="#journeys-top"
          class="mt-12 inline-block text-xs tracking-widest text-stone-500 uppercase transition-colors hover:text-stone-800"
        >
          ↑ Back to all experiences
        </a>
      </div>
    </div>
  </div>
  <Footer />
</Layout>
