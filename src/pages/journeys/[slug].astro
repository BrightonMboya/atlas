---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import RouteMap from "../../components/journey/RouteMap.astro";
import {
  catalogue,
  journeys,
  lowestRate,
  parseItinerary,
  routeFor,
  type DocumentEntry,
  type Section,
} from "../../data/journeys";

export function getStaticPaths() {
  return catalogue.map((journey) => ({ params: { slug: journey.slug }, props: { journey } }));
}

interface Props {
  journey: DocumentEntry;
}

const { journey } = Astro.props;
const itinerary = parseItinerary(journey);
const route = routeFor(itinerary);
const rate = lowestRate(itinerary);
const related = journeys
  .filter((entry) => entry.slug !== journey.slug && entry.activity === journey.activity)
  .slice(0, 3);

const title = journey.days
  ? `${journey.title} — ${journey.days} Days | Atlas Safaris`
  : `${journey.title} | Atlas Safaris`;

const chain = route ? [route.start, ...route.points, route.end].filter((p) => p != null) : [];
const routeLabel = chain.length > 1 ? `${chain[0].name} → ${chain[chain.length - 1].name}` : undefined;

// The guides (Mount Kilimanjaro, Zanzibar excursions) have no day list; their
// body is the run of sections, filed under the document's own ALL-CAPS headings.
const isGuide = itinerary.days.length === 0;
const groupedSections = itinerary.sections.reduce<{ group?: string; sections: Section[] }[]>(
  (groups, section) => {
    const last = groups[groups.length - 1];
    if (last && last.group === section.group) last.sections.push(section);
    else groups.push({ group: section.group, sections: [section] });
    return groups;
  },
  [],
);

/** "2 Pax – From $4,467 per person" reads better as a row than a sentence. */
function splitRate(text: string): { label?: string; amount: string } {
  const match = text.match(/^(.*?)\s+[–—]\s+(\$.*)$/);
  return match ? { label: match[1], amount: match[2] } : { amount: text };
}
---

<Layout title={title} description={journey.summary}>
  <Navbar />
  <div class="min-h-screen bg-[#FDFCFB] font-body text-stone-800 selection:bg-stone-200">
    <!-- Hero -->
    <section class="relative h-[85vh] w-full overflow-hidden bg-stone-900">
      <img
        src={journey.image}
        alt={journey.alt}
        class="animate-reveal absolute inset-0 size-full scale-105 object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-black/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

      <nav
        class="absolute inset-x-0 top-0 z-10 flex items-center gap-2 px-6 pt-8 text-xs tracking-[0.16em] text-white/70 uppercase sm:px-10"
        aria-label="Breadcrumb"
      >
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/journeys" class="transition-colors hover:text-white">Journeys</a>
      </nav>

      <div class="relative flex h-full flex-col items-center justify-center px-6 text-center">
        <span class="animate-fade-in-up mb-4 text-xs tracking-[0.3em] text-white/80 uppercase">
          {journey.category}
        </span>
        <h1
          class="animate-fade-in-up mb-6 max-w-4xl font-display text-5xl leading-tight text-white [animation-delay:200ms] md:text-7xl"
        >
          {journey.title}
        </h1>
        <div
          class="animate-fade-in-up flex items-center gap-8 text-sm tracking-widest text-white/90 uppercase [animation-delay:400ms]"
        >
          {journey.days && <span>{journey.days} Days</span>}
          {journey.days && <span class="h-8 w-px bg-white/30"></span>}
          <span>{journey.region}</span>
        </div>
      </div>

      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce">
        <div class="h-16 w-px bg-gradient-to-t from-white to-transparent"></div>
      </div>
    </section>

    <!-- Trip at a glance -->
    {
      itinerary.destinations.length > 0 && (
        <section class="border-b border-stone-100 bg-white">
          <div class="mx-auto max-w-screen-xl px-6 py-16 md:py-20">
            <h2 class="mb-10 text-center text-xs font-medium tracking-[0.3em] text-stone-400 uppercase">
              Your Destinations
            </h2>

            <div class="mb-12 flex flex-wrap items-center justify-center gap-3 md:gap-4">
              {itinerary.destinations.map((dest, idx) => (
                <>
                  <span class="font-display text-xl text-stone-700 italic md:text-2xl">{dest}</span>
                  {idx < itinerary.destinations.length - 1 && <span class="text-stone-300">—</span>}
                </>
              ))}
            </div>

            <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-8 text-center md:gap-12">
              {journey.days && (
                <div>
                  <span class="mb-1 block text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                    Duration
                  </span>
                  <span class="text-sm text-stone-600">{journey.days} days</span>
                </div>
              )}

              {routeLabel && (
                <div>
                  <span class="mb-1 block text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                    Route
                  </span>
                  <span class="text-sm text-stone-600">{routeLabel}</span>
                </div>
              )}

              <div>
                <span class="mb-1 block text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                  Experience
                </span>
                <span class="text-sm text-stone-600">{journey.category}</span>
              </div>

              {rate && (
                <div>
                  <span class="mb-1 block text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                    {rate.basis ?? "Price"}
                  </span>
                  <span class="text-sm text-stone-600">From ${rate.amount.toLocaleString("en-US")}</span>
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <!-- Main content -->
    <main class="mx-auto max-w-screen-xl px-6 py-24 md:py-32">
      <div class="grid grid-cols-1 gap-24 lg:grid-cols-[1fr_400px]">
        <!-- Left column: the day by day -->
        <div class="space-y-32">
          {
            (itinerary.meta.length > 0 || itinerary.intro.length > 0) && (
              <div class="space-y-4">
                {itinerary.meta.map((line) => (
                  <p class="text-xs tracking-[0.2em] text-stone-400 uppercase">{line}</p>
                ))}
                {itinerary.intro.map((paragraph) => (
                  <p class="text-lg leading-relaxed text-stone-600">{paragraph}</p>
                ))}
              </div>
            )
          }

          {
            !isGuide && (
              <div>
                <h2 class="mb-12 text-sm tracking-[0.2em] text-stone-400 uppercase">The Journey</h2>

                <div class="space-y-24">
                  {itinerary.days.map((day, dayIndex) => {
                    const previousDay = dayIndex > 0 ? itinerary.days[dayIndex - 1] : null;
                    // Consecutive nights in one place are marked "(Cont.)" rather
                    // than restating the region as if it were a new stay.
                    const isSameStay =
                      previousDay != null &&
                      previousDay.overnight != null &&
                      previousDay.overnight === day.overnight;

                    return (
                      <div class="group scroll-mt-24" id={day.id}>
                        <div class="flex flex-col gap-8 md:flex-row md:gap-16">
                          <div class="shrink-0 md:w-32">
                            <span class="font-display text-5xl text-stone-200 italic transition-colors group-hover:text-stone-300">
                              {day.n < 10 ? `0${day.n}` : day.n}
                            </span>
                            <p class="mt-2 text-xs tracking-widest text-stone-500 uppercase">
                              {day.label}
                            </p>
                          </div>

                          <div class="flex-1 space-y-12">
                            <div>
                              <h3 class="font-display text-3xl leading-tight text-stone-800 md:text-4xl">
                                {day.title}
                              </h3>
                              {day.subtitle && (
                                <p class="mt-3 font-display text-xl text-stone-500 italic">
                                  {day.subtitle}
                                </p>
                              )}
                            </div>

                            {day.paragraphs.length > 0 && (
                              <div class="space-y-4">
                                {day.paragraphs.map((p) => (
                                  <p class="text-lg leading-relaxed text-stone-600">{p}</p>
                                ))}
                              </div>
                            )}

                            {day.facts.length > 0 && (
                              <div class="space-y-8">
                                <div class="flex items-center gap-4">
                                  <span class="text-xs font-medium tracking-[0.2em] text-stone-400 uppercase">
                                    On The Trail
                                  </span>
                                  <div class="h-px flex-1 bg-stone-200" />
                                </div>
                                <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                                  {day.facts.map((fact) => (
                                    <div class="relative border-l border-stone-200 pl-8">
                                      <div class="absolute top-1.5 -left-[5px] size-2.5 rounded-full bg-stone-300 outline outline-4 outline-[#FDFCFB]" />
                                      <dt class="text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                                        {fact.label}
                                      </dt>
                                      <dd class="mt-1 text-sm text-stone-700">{fact.value}</dd>
                                    </div>
                                  ))}
                                </dl>
                              </div>
                            )}

                            {(day.overnight || day.meals) && (
                              <div class="flex flex-col justify-between gap-8 rounded-2xl bg-stone-50 p-8 md:flex-row">
                                {day.overnight && (
                                  <div>
                                    <span class="mb-2 block text-[10px] tracking-[0.2em] text-stone-400 uppercase">
                                      {day.stayLabel ?? "Overnight"}
                                    </span>
                                    <span
                                      class:list={[
                                        "font-display text-lg text-stone-700 italic",
                                        isSameStay && "opacity-50",
                                      ]}
                                    >
                                      {day.overnight}
                                      {isSameStay && (
                                        <span class="ml-2 text-xs text-stone-400 not-italic">
                                          (Cont.)
                                        </span>
                                      )}
                                    </span>
                                  </div>
                                )}
                                {day.meals && (
                                  <div class="md:text-right">
                                    <span class="mb-2 block text-[10px] tracking-[0.2em] text-stone-400 uppercase">
                                      {day.mealsLabel ?? "Meals"}
                                    </span>
                                    <span class="text-sm text-stone-600 italic">{day.meals}</span>
                                  </div>
                                )}
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )
          }

          {
            groupedSections.map(({ group, sections }) => (
              <div>
                {group && (
                  <h2 class="mb-12 text-sm tracking-[0.2em] text-stone-400 uppercase">{group}</h2>
                )}
                <div class="space-y-16">
                  {sections.map((section) => (
                    <div id={section.id} class="scroll-mt-24">
                      <h3 class="font-display text-3xl leading-tight text-stone-800 md:text-4xl">
                        {section.title}
                      </h3>
                      {section.subtitle && (
                        <p class="mt-3 font-display text-xl text-stone-500 italic">
                          {section.subtitle}
                        </p>
                      )}
                      <div class="mt-8 space-y-4">
                        {section.paragraphs.map((p) => (
                          <p class="text-lg leading-relaxed text-stone-600">{p}</p>
                        ))}
                      </div>
                      {section.items.length > 0 && (
                        <ul class="mt-8 space-y-3">
                          {section.items.map((item) => (
                            <li class="flex items-start gap-3 leading-relaxed text-stone-600">
                              <span class="font-bold text-stone-400">+</span>
                              {item}
                            </li>
                          ))}
                        </ul>
                      )}
                      {section.facts.length > 0 && (
                        <dl class="mt-8 space-y-2">
                          {section.facts.map((fact) => (
                            <div class="flex flex-wrap items-baseline gap-2 text-sm">
                              <dt class="text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                                {fact.label}
                              </dt>
                              <dd class="text-stone-600">{fact.value}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <!-- Right column: details & CTA -->
        <aside class="space-y-16">
          <div class="sticky top-24 space-y-16">
            <div class="rounded-3xl border border-stone-100 bg-white p-8 shadow-sm md:p-10">
              {route && <div class="mb-10"><RouteMap route={route} /></div>}

              <div class="mb-8 border-b border-stone-100 pb-8">
                <h3 class="mb-6 text-sm font-medium tracking-[0.2em] text-stone-400 uppercase">
                  Trip Summary
                </h3>
                <div class="space-y-4">
                  {
                    journey.days && (
                      <div class="flex items-center justify-between gap-4 text-sm">
                        <span class="text-stone-400">Duration</span>
                        <span class="font-medium">{journey.days} days</span>
                      </div>
                    )
                  }
                  <div class="flex items-center justify-between gap-4 text-sm">
                    <span class="text-stone-400">Destination</span>
                    <span class="text-right font-medium italic">{journey.region}</span>
                  </div>
                  {
                    itinerary.destinations.length > 0 && (
                      <div class="flex items-center justify-between gap-4 text-sm">
                        <span class="text-stone-400">Stops</span>
                        <span class="font-medium">{itinerary.destinations.length}</span>
                      </div>
                    )
                  }
                  <div class="flex items-center justify-between gap-4 text-sm">
                    <span class="text-stone-400">Experience</span>
                    <span class="text-right font-medium">{journey.category}</span>
                  </div>
                </div>
              </div>

              {
                itinerary.prices.length > 0 && (
                  <div class="mb-8 border-b border-stone-100 pb-8">
                    <h3 class="mb-6 text-sm font-medium tracking-[0.2em] text-stone-400 uppercase">
                      Pricing
                    </h3>

                    {rate && (
                      <div class="mb-6 space-y-2">
                        <div class="flex items-baseline justify-between gap-4">
                          <span class="text-xs text-stone-400">From</span>
                          <span class="font-display text-2xl text-stone-800">
                            ${rate.amount.toLocaleString("en-US")}
                          </span>
                        </div>
                        {(rate.basis || rate.season) && (
                          <div class="flex items-center justify-between gap-4 text-[10px] font-bold tracking-widest text-stone-400 uppercase">
                            <span>{rate.basis}</span>
                            <span>{rate.season}</span>
                          </div>
                        )}
                      </div>
                    )}

                    <div class="space-y-6 border-t border-stone-100 pt-6">
                      {itinerary.prices.map((group) => (
                        <div>
                          {group.season && (
                            <h4 class="mb-3 text-[10px] font-bold tracking-[0.2em] text-stone-400 uppercase">
                              {group.season}
                            </h4>
                          )}
                          <ul class="space-y-3">
                            {group.lines.map((line) => {
                              const { label, amount } = splitRate(line);
                              return (
                                <li class="flex items-baseline justify-between gap-4 text-sm text-stone-600">
                                  {label && <span>{label}</span>}
                                  <span
                                    class:list={[
                                      "text-right text-stone-500",
                                      label && "whitespace-nowrap",
                                    ]}
                                  >
                                    {amount}
                                  </span>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      ))}
                    </div>

                    {itinerary.priceNotes.length > 0 && (
                      <div class="mt-6 space-y-2">
                        {itinerary.priceNotes.map((note) => (
                          <p class="text-xs leading-relaxed text-stone-400">{note}</p>
                        ))}
                      </div>
                    )}
                  </div>
                )
              }

              {
                (itinerary.inclusions.length > 0 || itinerary.exclusions.length > 0) && (
                  <div class="mb-10 space-y-8">
                    {itinerary.inclusions.length > 0 && (
                      <div>
                        <h4 class="mb-4 flex items-center gap-2 text-[11px] font-bold tracking-[0.2em] text-stone-500 uppercase">
                          <span class="size-1.5 rounded-full bg-stone-500" />
                          Inclusions
                        </h4>
                        <ul class="space-y-3">
                          {itinerary.inclusions.map((item) => (
                            <li class="flex items-start gap-3 text-sm leading-relaxed text-stone-600">
                              <span class="font-bold text-stone-400">+</span>
                              {item}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {itinerary.exclusions.length > 0 && (
                      <div class:list={[itinerary.inclusions.length > 0 && "border-t border-stone-100 pt-8"]}>
                        <h4 class="mb-4 flex items-center gap-2 text-[11px] font-bold tracking-[0.2em] text-stone-500 uppercase">
                          <span class="size-1.5 rounded-full bg-stone-300" />
                          Exclusions
                        </h4>
                        <ul class="space-y-3">
                          {itinerary.exclusions.map((item) => (
                            <li class="flex items-start gap-3 text-sm leading-relaxed text-stone-600">
                              <span class="font-bold text-stone-300">-</span>
                              {item}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )
              }

              <a
                href="/plan-my-trip"
                class="block w-full rounded-xl bg-accent px-8 py-5 text-center text-sm font-medium tracking-[0.2em] text-white uppercase transition-colors hover:bg-accent-dark"
              >
                {isGuide ? "Plan My Trip" : "Enquire About This Journey"}
              </a>
            </div>

            <div class="space-y-8 px-4">
              <div class="border-t border-stone-100 pt-6">
                <span class="block text-[10px] tracking-wider text-stone-400 uppercase">
                  Curated by
                </span>
                <span class="text-sm font-medium text-stone-700">Atlas Safaris</span>
                <p class="mt-4 text-xs leading-relaxed text-stone-500">
                  Every Atlas journey is private and built around you — your pace, your interests
                  and your travel dates. Tell us what you have in mind and we will shape this
                  itinerary around it.
                </p>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <!-- Related journeys -->
    {
      related.length > 0 && (
        <section class="border-t border-stone-100">
          <div class="mx-auto max-w-screen-xl px-6 py-20 md:py-24">
            <h2 class="mb-12 text-sm tracking-[0.2em] text-stone-400 uppercase">More Itineraries</h2>
            <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
              {related.map((entry) => (
                <a href={`/journeys/${entry.slug}`} class="group flex flex-col gap-4">
                  <div class="aspect-[5/6] w-full overflow-hidden rounded-2xl">
                    <img
                      src={entry.image}
                      alt={entry.alt}
                      loading="lazy"
                      class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                  </div>
                  <span class="text-[10px] font-medium tracking-[0.2em] text-stone-400 uppercase">
                    {entry.category} · {entry.days} Days
                  </span>
                  <h3 class="font-display text-2xl leading-tight text-stone-800">{entry.title}</h3>
                  <span class="text-xs tracking-widest text-stone-500 uppercase transition-colors group-hover:text-stone-800">
                    View Itinerary →
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
  <Footer />
</Layout>

<style>
  @keyframes reveal {
    from {
      transform: scale(1.1);
      opacity: 0;
    }
    to {
      transform: scale(1.05);
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-reveal {
    animation: reveal 1.5s ease-out forwards;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-reveal,
    .animate-fade-in-up,
    .animate-bounce {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
