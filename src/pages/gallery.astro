---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
// Generated by scripts/build-gallery.mjs from scripts/gallery-sources.json —
// edit the sources and re-run the script, never this file.
import photos from "../data/gallery.json";

const filters = [
  { id: "all", label: "All" },
  { id: "safari", label: "Safari" },
  { id: "trekking", label: "Kilimanjaro & Meru" },
  { id: "zanzibar", label: "Zanzibar" },
];

// The first row or so is above the fold: load it straight away and lazy-load
// the rest as the visitor scrolls.
const EAGER = 6;
---

<Layout
  title="Gallery | Atlas Safaris"
  description="Photographs from Atlas Safaris journeys across Tanzania — wildlife and sundowners on safari, the trails of Kilimanjaro and Mount Meru, and the beaches of Zanzibar."
>
  <Navbar />

  <main class="bg-white">
    <header class="border-b border-border/60 bg-[#FDFCFB]">
      <div class="mx-auto w-full max-w-[1400px] px-6 py-16 sm:px-10 md:py-24 lg:px-16">
        <div class="max-w-3xl">
          <span class="block font-body text-xs tracking-[0.3em] text-text-muted uppercase">Gallery</span>
          <h1 class="mt-5 font-display text-[38px] leading-[1.1] text-primary sm:text-[46px] xl:text-[56px]">
            Tanzania, Through Our Lens.
          </h1>
          <p class="mt-6 font-body text-[15px] leading-[170%] text-text sm:text-base">
            Sundowners on the plains, the long climb to Uhuru Peak and slow days on Zanzibar’s coast —
            a glimpse of the journeys we plan.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter photographs">
          {
            filters.map((filter, i) => (
              <button
                type="button"
                data-filter={filter.id}
                aria-pressed={i === 0 ? "true" : "false"}
                class="cursor-pointer rounded-full border border-border px-4 py-2 font-body text-xs tracking-[0.12em] text-primary uppercase transition-colors hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
              >
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>
    </header>

    <div class="mx-auto w-full max-w-[1400px] px-4 py-12 sm:px-10 md:py-16 lg:px-16">
      <ul class="gallery-grid columns-2 gap-3 sm:gap-4 lg:columns-3 xl:columns-4">
        {
          photos.map((photo, i) => (
            <li class="mb-3 break-inside-avoid sm:mb-4" data-group={photo.group}>
              <button
                type="button"
                class="group block w-full cursor-zoom-in overflow-hidden rounded-xl bg-stone-100 bg-cover bg-center"
                style={`background-image:url(${photo.placeholder})`}
                data-gallery-group="gallery"
                data-full={photo.full}
                data-name={photo.alt}
                aria-label={`Enlarge: ${photo.alt}`}
              >
                <img
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes="(min-width: 1280px) 320px, (min-width: 1024px) 31vw, 48vw"
                  width={photo.width}
                  height={photo.height}
                  alt={photo.alt}
                  loading={i < EAGER ? "eager" : "lazy"}
                  fetchpriority={i < 2 ? "high" : undefined}
                  decoding="async"
                  class="h-auto w-full transition-[transform,opacity] duration-500 group-hover:scale-[1.03]"
                />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <PhotoLightbox />
  <FinalCTA />
  <Footer />
</Layout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const tiles = [...document.querySelectorAll<HTMLElement>("[data-group]")];

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      // Hidden tiles also drop out of the lightbox's photo set.
      tiles.forEach((tile) => (tile.hidden = filter !== "all" && tile.dataset.group !== filter));
    });
  });
</script>

